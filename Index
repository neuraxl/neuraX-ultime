<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Guide National RACINES — Plateforme Interactive & Carnet Numérique</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap');
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 antialiased">

    <!-- En-tête -->
    <header class="bg-emerald-900 text-white shadow-xl sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 py-5 flex flex-col md:flex-row justify-between items-center">
            <div>
                <span class="text-xs uppercase tracking-widest bg-emerald-700 px-3 py-1 rounded-full font-semibold">Plateforme Nationale Officielle</span>
                <h1 class="text-3xl font-bold mt-2 tracking-tight">RACINES</h1>
                <p class="text-emerald-200 text-sm italic">« Grandir avec respect. Vivre avec conscience. Agir avec cœur. Construire ensemble. »</p>
            </div>
            <nav class="mt-4 md:mt-0 flex flex-wrap gap-2">
                <button onclick="switchTab('accueil')" class="tab-btn bg-emerald-700 text-white px-3 py-2 rounded-lg text-sm font-medium transition hover:bg-emerald-600">Accueil & Axes</button>
                <button onclick="switchTab('regions')" class="tab-btn bg-emerald-800/80 text-white px-3 py-2 rounded-lg text-sm font-medium transition hover:bg-emerald-600">Régions (17)</button>
                <button onclick="switchTab('outils')" class="tab-btn bg-emerald-800/80 text-white px-3 py-2 rounded-lg text-sm font-medium transition hover:bg-emerald-600">Boîte à Outils</button>
                <button onclick="switchTab('carnet')" class="tab-btn bg-emerald-800/80 text-white px-3 py-2 rounded-lg text-sm font-medium transition hover:bg-emerald-600">📖 Le Carnet RACINES</button>
                <button onclick="switchTab('apps')" class="tab-btn bg-emerald-800/80 text-white px-3 py-2 rounded-lg text-sm font-medium transition hover:bg-emerald-600">Applications</button>
            </nav>
        </div>
    </header>

    <!-- Contenu Principal -->
    <main class="max-w-7xl mx-auto px-4 py-8">

        <!-- ONGLET 1 : ACCUEIL & AXES -->
        <section id="tab-accueil" class="space-y-8 tab-content">
            <div class="bg-white p-8 rounded-2xl shadow-sm border border-slate-100">
                <h2 class="text-2xl font-bold text-emerald-900 mb-4">Cadre de Référence pour la Coéducation au Québec</h2>
                <p class="text-slate-600 leading-relaxed">
                    Le programme <strong>RACINES</strong> unifie la famille, les éducateurs, les écoles et la communauté autour d'un même projet de société : offrir aux enfants les repères nécessaires pour devenir des êtres humains conscients, autonomes et ancrés dans leur milieu de vie.
                </p>
            </div>

            <div class="grid md:grid-cols-3 gap-6">
                <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100 border-t-4 border-t-emerald-600">
                    <h3 class="font-bold text-lg text-slate-800 mb-1">👧 L'Enfant</h3>
                    <p class="text-emerald-700 font-medium text-sm mb-3">« Je découvre et j'apprends. »</p>
                    <p class="text-slate-600 text-sm">Acteur de sa démarche, guidé vers l'autonomie et le respect de ses propres rythmes d'apprentissage.</p>
                </div>
                <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100 border-t-4 border-t-teal-600">
                    <h3 class="font-bold text-lg text-slate-800 mb-1">👩‍🏫 L'Éducateur / Enseignant</h3>
                    <p class="text-teal-700 font-medium text-sm mb-3">« J'accompagne et je guide. »</p>
                    <p class="text-slate-600 text-sm">Passeur culturel, observateur attentif et médiateur bienveillant des conflits du quotidien.</p>
                </div>
                <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100 border-t-4 border-t-cyan-600">
                    <h3 class="font-bold text-lg text-slate-800 mb-1">👨‍👩‍👧 La Famille</h3>
                    <p class="text-cyan-700 font-medium text-sm mb-3">« J'écoute, je soutiens et je transmets. »</p>
                    <p class="text-slate-600 text-sm">Premier milieu affectif et culturel, en coresponsabilité active avec le milieu éducatif.</p>
                </div>
            </div>
        </section>

        <!-- ONGLET 2 : DÉCLINAISON RÉGIONALE -->
        <section id="tab-regions" class="space-y-6 tab-content hidden">
            <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100">
                <h2 class="text-2xl font-bold text-emerald-900 mb-2">Exploration Régionale du Québec (17 Régions)</h2>
                <p class="text-slate-600 text-sm mb-4">Sélectionnez votre région administrative pour découvrir son ancrage territorial spécifique :</p>
                <select id="regionSelect" onchange="displayRegionData()" class="w-full p-3 bg-slate-50 border border-slate-200 rounded-xl font-medium text-slate-700 focus:ring-2 focus:ring-emerald-600">
                    <option value="01">Région 01 — Bas-Saint-Laurent</option>
                    <option value="02">Région 02 — Saguenay–Lac-Saint-Jean</option>
                    <option value="03" selected>Région 03 — Capitale-Nationale (Québec)</option>
                    <option value="04">Région 04 — Mauricie</option>
                    <option value="05">Région 05 — Estrie (Cantons-de-l'Est)</option>
                    <option value="06">Région 06 — Montréal</option>
                    <option value="07">Région 07 — Outaouais</option>
                    <option value="08">Région 08 — Abitibi-Témiscamingue</option>
                    <option value="09">Région 09 — Côte-Nord</option>
                    <option value="10">Région 10 — Nord-du-Québec</option>
                    <option value="11">Région 11 — Gaspésie–Îles-de-la-Madeleine</option>
                    <option value="12">Région 12 — Chaudière-Appalaches</option>
                    <option value="13">Région 13 — Laval</option>
                    <option value="14">Région 14 — Lanaudière</option>
                    <option value="15">Région 15 — Laurentides</option>
                    <option value="16">Région 16 — Montérégie</option>
                    <option value="17">Région 17 — Centre-du-Québec</option>
                </select>
            </div>
            <div id="regionCard" class="bg-white p-8 rounded-2xl shadow-sm border border-slate-100 space-y-4"></div>
        </section>

        <!-- ONGLET 3 : BOÎTE À OUTILS -->
        <section id="tab-outils" class="space-y-6 tab-content hidden">
            <div class="bg-white p-8 rounded-2xl shadow-sm border border-slate-100">
                <h2 class="text-2xl font-bold text-emerald-900 mb-4">Boîte à Outils Pédagogiques</h2>
                <div class="grid md:grid-cols-2 gap-6">
                    <div class="border border-slate-200 p-6 rounded-xl bg-slate-50/50">
                        <h3 class="font-bold text-emerald-800 text-lg mb-2">📖 Le Carnet RACINES</h3>
                        <p class="text-slate-600 text-sm mb-3">Espace intime non noté de l'enfant : Mes découvertes, réussites, défis, souvenirs familiaux et projets communautaires.</p>
                    </div>
                    <div class="border border-slate-200 p-6 rounded-xl bg-slate-50/50">
                        <h3 class="font-bold text-emerald-800 text-lg mb-2">⏱️ Rencontre Mensuelle (4 x 5 min)</h3>
                        <p class="text-slate-600 text-sm mb-3">5 min de réussites + 5 min de défis + 5 min de stratégie commune + 5 min d'objectifs partagés.</p>
                    </div>
                    <div class="border border-slate-200 p-6 rounded-xl bg-slate-50/50">
                        <h3 class="font-bold text-emerald-800 text-lg mb-2">🛑 Méthode STOP (Conflits)</h3>
                        <p class="text-slate-600 text-sm mb-3">Stop → Écouter → Comprendre → Réparer → Apprendre. Transformer les tensions en apprentissages sociaux.</p>
                    </div>
                    <div class="border border-slate-200 p-6 rounded-xl bg-slate-50/50">
                        <h3 class="font-bold text-emerald-800 text-lg mb-2">📋 Plan RACINES (Personnalisé)</h3>
                        <p class="text-slate-600 text-sm mb-3">Outil d'accompagnement sur mesure pour les jeunes présentant des besoins particuliers (Forces, Besoins, Stratégies, Ressources).</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- ONGLET 4 : LE CARNET RACINES (NOUVEAUTÉ INTERACTIVE) -->
        <section id="tab-carnet" class="space-y-6 tab-content hidden">
            <div class="bg-white p-8 rounded-2xl shadow-sm border border-slate-100">
                <div class="border-b pb-4 mb-6 flex flex-col md:flex-row justify-between items-start md:items-center">
                    <div>
                        <span class="text-xs uppercase tracking-widest bg-emerald-100 text-emerald-800 px-3 py-1 rounded-full font-bold">Espace Personnel & Intime</span>
                        <h2 class="text-2xl font-bold text-emerald-900 mt-2">Mon Carnet RACINES</h2>
                        <p class="text-slate-600 text-sm">Ce carnet appartient symboliquement à l'enfant. Il n'est ni noté ni utilisé pour punir ou surveiller.</p>
                    </div>
                    <div class="mt-4 md:mt-0 flex gap-2">
                        <input type="text" id="enfantNom" placeholder="Nom ou prénom de l'enfant" class="p-2 border rounded-xl text-sm">
                    </div>
                </div>

                <!-- Formulaire d'ajout dans le carnet -->
                <div class="bg-slate-50 p-6 rounded-2xl border mb-8 space-y-4">
                    <h3 class="font-bold text-slate-800 text-lg">✍️ Ajouter une page ou une note dans mon carnet</h3>
                    <div class="grid md:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-bold text-slate-600 uppercase mb-1">Rubrique du Carnet</label>
                            <select id="carnetRubrique" class="w-full p-3 border rounded-xl text-sm bg-white">
                                <option value="Découvertes & Réussites">🌟 Mes découvertes & réussites</option>
                                <option value="Défis & Apprentissages">🌱 Mes défis et apprentissages</option>
                                <option value="Famille & Souvenirs">❤️ Ma famille et mes souvenirs</option>
                                <option value="Environnement Naturel">🌍 Mon environnement naturel</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-600 uppercase mb-1">Titre ou résumé de l'entrée</label>
                            <input type="text" id="carnetTitre" placeholder="Ex: J'ai réussi à faire du vélo sans petites roues !" class="w-full p-3 border rounded-xl text-sm bg-white">
                        </div>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-600 uppercase mb-1">Mon expression libre / Souvenir / Réflexion</label>
                        <textarea id="carnetTexte" rows="3" placeholder="Écris ce que tu as ressenti, appris ou découvert..." class="w-full p-3 border rounded-xl text-sm bg-white"></textarea>
                    </div>
                    <button onclick="ajouterEntreeCarnet()" class="bg-emerald-700 text-white px-6 py-2 rounded-xl text-sm font-medium hover:bg-emerald-600 transition">Ajouter à mon carnet</button>
                </div>

                <!-- Affichage des entrées du carnet -->
                <h3 class="font-bold text-emerald-900 text-xl mb-4">📚 Pages de mon carnet</h3>
                <div id="listeCarnet" class="grid md:grid-cols-2 gap-4">
                    <!-- Entrée par défaut -->
                    <div class="p-5 rounded-xl border border-emerald-100 bg-emerald-50/40 space-y-2">
                        <div class="flex justify-between items-center">
                            <span class="text-xs font-bold bg-emerald-200 text-emerald-800 px-2 py-0.5 rounded-full">🌟 Découvertes & Réussites</span>
                            <span class="text-xs text-slate-400">Aujourd'hui</span>
                        </div>
                        <h4 class="font-bold text-slate-800">Ma première page RACINES</h4>
                        <p class="text-slate-600 text-sm">Bienvenue dans mon carnet personnel. Je grandis, j'apprends et je découvre le monde avec respect !</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- ONGLET 5 : APPLICATIONS -->
        <section id="tab-apps" class="space-y-6 tab-content hidden">
            <div class="bg-white p-8 rounded-2xl shadow-sm border border-slate-100">
                <h3 class="text-xl font-bold text-emerald-900 mb-2">💡 Générateur de « Phrase du Jour »</h3>
                <div class="p-4 bg-emerald-50 rounded-xl border border-emerald-100 text-emerald-900 font-semibold text-lg min-h-[60px] flex items-center justify-center text-center mt-4" id="phraseBox">
                    « Qu'est-ce qui t'a fait sourire ou t'a rendu fier aujourd'hui ? »
                </div>
                <button onclick="genererPhrase()" class="mt-4 bg-emerald-700 text-white px-4 py-2 rounded-xl text-sm font-medium hover:bg-emerald-600 transition">Générer une autre question</button>
            </div>
        </section>

    </main>

    <!-- Pied de page -->
    <footer class="bg-slate-900 text-slate-400 py-8 mt-12 text-center text-sm">
        <p>Plateforme Web Interactive — Programme National RACINES © Québec</p>
    </footer>

    <!-- Scripts JavaScript -->
    <script>
        const regionsData = {
            "01": { name: "Région 01 — Bas-Saint-Laurent", context: "Territoire maritime et rural, proximité du fleuve Saint-Laurent.", eco: "Protection des berges et écosystèmes fluviaux.", passeur: "Témoignages de gardiens de phares et pêcheurs." },
            "02": { name: "Région 02 — Saguenay–Lac-Saint-Jean", context: "Immensité forestière et hydrographie majeure.", eco: "Traditions forestières et intégration des savoirs de Mashteuiatsh.", passeur: "Cartographie des bassins versants." },
            "03": { name: "Région 03 — Capitale-Nationale (Québec)", context: "Berceau historique de l'Amérique française, patrimoine UNESCO.", eco: "Visites pédagogiques du Vieux-Québec et parcs de la Jacques-Cartier.", passeur: "Mémoire institutionnelle et artistique de la Capitale." },
            "04": { name: "Région 04 — Mauricie", context: "Transition entre Basses-Landes et Bouclier canadien.", eco: "Étude historique de la drave et culture Atikamekw.", passeur: "Observation des cycles de la faune boréale." },
            "05": { name: "Région 05 — Estrie (Cantons-de-l'Est)", context: "Relief vallonné, proximité des Appalaches.", eco: "Protection des lacs intérieurs et des écosystèmes montagnards.", passeur: "Conseils des Enfants axés sur le développement durable." },
            "06": { name: "Région 06 — Montréal", context: "Métropole cosmopolite, multiculturelle et dense.", eco: "Célébration de la mosaïque interculturelle et autochtone.", passeur: "Partenariats avec les musées et bibliothèques de quartier." },
            "07": { name: "Région 07 — Outaouais", context: "Région frontalière, bilingue, vallée des Outaouais.", eco: "Traditions ancestrales algonquines de Kitigan Zibi.", passeur: "Dialogue interculturel et interlinguistique." },
            "08": { name: "Région 08 — Abitibi-Témiscamingue", context: "Territoire minier et forestier, grands espaces.", eco: "Collaboration avec les communautés Anishinabeg et Cries.", passeur: "Respect de la biodiversité boréale." },
            "09": { name: "Région 09 — Côte-Nord", context: "Immersion côtière, fjordienne et nitassinan.", eco: "Sensibilisation au biorégionalisme marin et boréal.", passeur: "Récits traditionnels innus (Nutshimit)." },
            "10": { name: "Région 10 — Nord-du-Québec", context: "Territoire arctique et subarctique (Nunavik / Eeyou Istchee).", eco: "Préservation de la banquise et des migrations fauniques.", passeur: "Valeurs communautaires cries et inuites." },
            "11": { name: "Région 11 — Gaspésie–Îles-de-la-Madeleine", context: "Péninsule maritime et archipel insulaire.", eco: "Patrimoine vivant acadien et protection des littoraux.", passeur: "Contes acadiens et traditions maritimes." },
            "12": { name: "Région 12 — Chaudière-Appalaches", context: "Région agro-forestière traversée par les Appalaches.", eco: "Traditions acéricoles et agro-pastorales.", passeur: "Implication des cercles de fermières et aînés." },
            "13": { name: "Région 13 — Laval", context: "Île urbaine et suburbaine à forte densité.", eco: "Protection des parcs urbains et berges de la rivière des Mille Îles.", passeur: "Engagement civique scolaire multiculturel." },
            "14": { name: "Région 14 — Lanaudière", context: "Basses-terres agricoles et forêts sauvages du nord.", eco: "Folklore québécois et danse traditionnelle.", passeur: "Veillées de contes et légendes régionales." },
            "15": { name: "Région 15 — Laurentides", context: "Région de villégiature et de montagnes.", eco: "Cohabitation avec la grande faune et protection des lacs.", passeur: "Éducation environnementale et plein air." },
            "16": { name: "Région 16 — Montérégie", context: "Plaine agricole fertile et collines montérégiennes.", eco: "Histoire agricole et biodiversité des monts St-Hilaire et Rougemont.", passeur: "Partenariats agroalimentaires locaux." },
            "17": { name: "Région 17 — Centre-du-Québec", context: "Cœur nourricier et logistique du Québec.", eco: "Éducation à l'alimentation saine et locale.", passeur: "Innovation rurale et artisanat du bois." }
        };

        const phrases = [
            "« Qu'est-ce qui t'a fait sourire ou t'a rendu fier aujourd'hui ? »",
            "« Est-ce que tu as aidé quelqu'un aujourd'hui, ou est-ce que quelqu'un t'a aidé ? »",
            "« Quelle a été la chose la plus difficile pour toi aujourd'hui, et comment as-tu fait ? »",
            "« De quoi as-tu envie qu'on discute ou qu'on essaie ensemble demain ? »"
        ];

        function switchTab(tabId) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            document.querySelectorAll('.tab-btn').forEach(el => {
                el.classList.remove('bg-emerald-700');
                el.classList.add('bg-emerald-800/80');
            });
            document.getElementById('tab-' + tabId).classList.remove('hidden');
            event.target.classList.remove('bg-emerald-800/80');
            event.target.classList.add('bg-emerald-700');
        }

        function displayRegionData() {
            const code = document.getElementById('regionSelect').value;
            const data = regionsData[code];
            document.getElementById('regionCard').innerHTML = `
                <h3 class="text-xl font-bold text-slate-800">${data.name}</h3>
                <p class="text-slate-600 text-sm"><strong>Contexte :</strong> ${data.context}</p>
                <p class="text-slate-600 text-sm"><strong>Focus Éco :</strong> ${data.eco}</p>
                <div class="p-3 bg-emerald-50 rounded-xl border border-emerald-100 text-emerald-900 text-sm">
                    <strong>Grand-Parent Passeur :</strong> ${data.passeur}
                </div>
            `;
        }

        function genererPhrase() {
            const aleatoire = phrases[Math.floor(Math.random() * phrases.length)];
            document.getElementById('phraseBox').innerText = aleatoire;
        }

        function ajouterEntreeCarnet() {
            const rubrique = document.getElementById('carnetRubrique').value;
            const titre = document.getElementById('carnetTitre').value || "Sans titre";
            const texte = document.getElementById('carnetTexte').value || "Aucune description.";
            const liste = document.getElementById('listeCarnet');

            const card = document.createElement('div');
            card.className = "p-5 rounded-xl border border-slate-200 bg-white shadow-sm space-y-2";
            card.innerHTML = `
                <div class="flex justify-between items-center">
                    <span class="text-xs font-bold bg-slate-100 text-slate-700 px-2 py-0.5 rounded-full">${rubrique}</span>
                    <span class="text-xs text-slate-400">À l'instant</span>
                </div>
                <h4 class="font-bold text-slate-800">${titre}</h4>
                <p class="text-slate-600 text-sm">${texte}</p>
            `;
            liste.prepend(card);

            document.getElementById('carnetTitre').value = '';
            document.getElementById('carnetTexte').value = '';
        }

        window.onload = displayRegionData;
    </script>
</body>
</html>
